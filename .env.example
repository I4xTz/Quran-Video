# Copy to .env and fill in before running docker-compose.prod.yml.

# Database password (used by Postgres, the backend and the frontend).
# NOTE: Postgres only reads it when the volume is first created.
POSTGRES_PASSWORD=change-me-long-random-password

# Signs login sessions. Generate with: openssl rand -hex 32
AUTH_SECRET=

# Comma-separated emails allowed to run the server-wide temp-file cleanup.
ADMIN_EMAILS=

# Contact address shown on the privacy policy and terms pages. The contact
# section is hidden while this is empty.
CONTACT_EMAIL=

# Optional.
HUGGINGFACE_TOKEN=

# --- Publishing to YouTube / TikTok / Instagram (all optional) -------------
# Leave a platform's keys empty and it simply shows as "not configured".
#
# Public address of this site, no trailing slash (e.g. https://example.com).
# Each platform must have this exact redirect URI registered:
#   <APP_URL>/api/social/youtube/callback
#   <APP_URL>/api/social/tiktok/callback
#   <APP_URL>/api/social/instagram/callback
# Empty = taken from the request (fine for http://localhost:3000, which only
# Google accepts -- TikTok and Instagram require https).
APP_URL=

# Google Cloud Console > APIs & Services: enable "YouTube Data API v3",
# then Credentials > OAuth client ID > Web application.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# developers.tiktok.com > your app, with Login Kit + Content Posting API.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# direct = post straight to the account (video.publish scope).
# inbox  = send to the TikTok inbox as a draft to finish in the app
#          (video.upload scope). Reconnect the account after changing this.
TIKTOK_POST_MODE=direct

# developers.facebook.com > your app > Instagram > "API setup with Instagram
# login" (the Instagram app ID/secret, not the Meta app's). The Instagram
# account must be a Business or Creator account.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
