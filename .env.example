# Copy to .env and fill in before running docker-compose.prod.yml.

# Database password (used by Postgres, the backend and the frontend).
# NOTE: Postgres only reads it when the volume is first created.
POSTGRES_PASSWORD=change-me-long-random-password

# Signs login sessions. Generate with: openssl rand -hex 32
AUTH_SECRET=

# Comma-separated emails allowed to run the server-wide temp-file cleanup.
ADMIN_EMAILS=

# Optional.
HUGGINGFACE_TOKEN=
